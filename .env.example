# Published host port of the stack
APP_PORT=8080
APP_URL=http://localhost:8080

# Comma-separated IPs/CIDRs of proxies in front of the Nginx gateway; empty trusts none.
TRUSTED_PROXIES=

# Generated by scripts/prepare-env.sh when .env is created
SECRET_KEY=generate-with-scripts/prepare-env.sh
POSTGRES_DB=fidus
POSTGRES_USER=fidus
POSTGRES_PASSWORD=generate-with-scripts/prepare-env.sh

# Application database role: not a superuser, no BYPASSRLS, subject to row-level security.
# The migrate service creates it and keeps its password in sync with this value.
APP_DB_USER=fidus_app
APP_DB_PASSWORD=generate-with-scripts/prepare-env.sh

# Required: the single provider key for chat, transcription, embeddings, speech and web search
OPENAI_API_KEY=

# Persistent local file storage path inside the backend and worker containers
STORAGE_PATH=/data/files

# Default registration mode after the first admin: open, invite-only or closed (admins can override it at runtime)
REGISTRATION_MODE=open

# Maximum authentication attempts per client IP and account identifier in the fixed window
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum authenticated MCP requests per personal access token in the fixed window
MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Install test dependencies (pytest) into the backend image so `docker compose exec backend pytest` works.
# Set to false for a production image without test tooling.
BACKEND_INSTALL_DEV=true
