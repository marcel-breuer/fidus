{
  "name": "fidus-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "api:generate": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "openapi-typescript": "^7.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  }
}
